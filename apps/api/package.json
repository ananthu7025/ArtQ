{
  "name": "@artq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:from-docs": "node scripts/db-from-docs.mjs",
    "db:check": "node scripts/db-from-docs.mjs --check && node scripts/check-migrations.mjs",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed/cli.ts",
    "db:seed:dist": "node dist/seed/cli.js",
    "compat:smoke": "tsx scripts/compat-smoke.tsx",
    "test:compose": "COMPOSE_TESTS=1 vitest run test/compose",
    "test:compose:integration": "TEST_DATABASE_URL=postgresql://artq:artq@localhost:55432/artq TEST_REDIS_URL=redis://localhost:56379 vitest run test/integration"
  },
  "dependencies": {
    "@artq/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.9.0",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nodemailer": "10.0.13",
    "otplib": "13.5.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.3.0",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@artq/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "6.19.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
