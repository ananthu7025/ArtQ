{
  "name": "@artq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "compat:smoke": "tsx scripts/compat-smoke.tsx"
  },
  "dependencies": {
    "@artq/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.9.0",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "otplib": "13.5.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5",
    "cors": "2.8.6",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@artq/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@types/cors": "2.8.19",
    "embedded-postgres": "16.14.0-beta.17",
    "yaml": "2.9.1"
  }
}
