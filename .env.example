# Copy to apps/api/.env for local development (task 0.3). Never commit real secrets.
NODE_ENV=development
PORT=4000
APP_VERSION=dev
LOG_LEVEL=info
DATABASE_URL=postgresql://artq:artq@localhost:55432/artq
REDIS_URL=redis://localhost:56379
# Exact origins allowed to call the API with cookies (comma-separated); see architecture.md §5.5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Auth secrets: development placeholders only (staging/production refuse values starting with "dev-insecure")
AUTH_JWT_SECRET=dev-insecure-jwt-secret-0123456789abcdef
# Optional; defaults to artq-<NODE_ENV>
AUTH_JWT_ISSUER=artq-development
AUTH_OTP_PEPPER=dev-insecure-otp-pepper-0123
AUTH_LINK_SECRET=dev-insecure-link-secret-0123456789abcdef
WEB_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_BUCKET_PUBLIC=artq-public
S3_BUCKET_PRIVATE=artq-private
SMTP_HOST=localhost
SMTP_PORT=1025
# Web (apps/web/.env.local) and admin (apps/admin/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
VITE_API_URL=http://localhost:4000/v1
