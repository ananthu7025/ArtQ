# Copy to apps/api/.env for local development (task 0.3). Never commit real secrets.
NODE_ENV=development
PORT=4000
APP_VERSION=dev
LOG_LEVEL=info
DATABASE_URL=postgresql://artq:artq@localhost:55432/artq
REDIS_URL=redis://localhost:56379
# Exact browser origins allowed to call the API (comma-separated); admin origins are the only ones accepted on /v1/admin/*.
# See architecture.md §5.5.
STOREFRONT_ORIGINS=http://localhost:3000
ADMIN_ORIGINS=http://localhost:5173
# Auth secrets: development placeholders only (staging/production refuse values starting with "dev-insecure")
AUTH_JWT_SECRET=dev-insecure-jwt-secret-0123456789abcdef
# Optional; defaults to artq-<NODE_ENV>
AUTH_JWT_ISSUER=artq-development
AUTH_OTP_PEPPER=dev-insecure-otp-pepper-0123
AUTH_LINK_SECRET=dev-insecure-link-secret-0123456789abcdef
WEB_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_BUCKET_PUBLIC=artq-public
S3_BUCKET_PRIVATE=artq-private
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Public renditions base URL (CDN in production); defaults to <S3_ENDPOINT>/<S3_BUCKET_PUBLIC>
MEDIA_PUBLIC_BASE_URL=http://localhost:9090/artq-public
# Email: smtp (Mailpit locally, UI on :8025) or resend (staging/production; set RESEND_API_KEY)
EMAIL_TRANSPORT=smtp
EMAIL_FROM="ArtQ <no-reply@artq.in>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
# Razorpay webhook secret (Phase 4); empty ⇒ the webhook endpoint answers 503 and Razorpay retries
RAZORPAY_WEBHOOK_SECRET=
# Razorpay API keys (rzp_test_… locally; live keys only in production). Empty: paying online is off (COD only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Web (apps/web/.env.local) and admin (apps/admin/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
VITE_API_URL=http://localhost:4000/v1
